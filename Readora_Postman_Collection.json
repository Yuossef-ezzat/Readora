{
  "info": {
    "name": "Readora API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:5001",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Public)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"member@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "register"]
            },
            "description": "🔓 Public - Creates a new Member account."
          }
        },
        {
          "name": "Create Librarian (Admin only)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Library\",\n  \"lastName\": \"Staff\",\n  \"email\": \"librarian@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/create-librarian",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "create-librarian"]
            },
            "description": "🔒 Requires: Admin — Creates a new Librarian account."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) pm.collectionVariables.set(\"access_token\", jsonData.token);",
                  "if (jsonData.refreshToken) pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "console.log(\"✅ Tokens saved!\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "login"]
            },
            "description": "🔓 Public - Token is auto-saved to collection variables after login."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) pm.collectionVariables.set(\"access_token\", jsonData.token);",
                  "if (jsonData.refreshToken) pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "refresh-token"]
            },
            "description": "🔓 Public - Use the saved refresh_token to get a new access_token."
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/Auth/revoke-token?token={{refresh_token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "revoke-token"],
              "query": [
                {
                  "key": "token",
                  "value": "{{refresh_token}}"
                }
              ]
            },
            "description": "🔒 Requires: Any authenticated user."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\"member@example.com\"",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "forgot-password"]
            },
            "description": "🔓 Public - Sends OTP to email. Body is a plain JSON string."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@example.com\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "verify-otp"]
            },
            "description": "🔓 Public - Verifies OTP before resetting password."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/Auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "Auth", "reset-password"]
            },
            "description": "🔓 Public - Resets the password using the verified OTP."
          }
        }
      ]
    },
