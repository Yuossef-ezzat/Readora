        {
          "name": "Borrow Book (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Unique key per request to prevent duplicate borrowing"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/Borrowings/borrow/1",
              "host": ["{{base_url}}"],
              "path": ["api", "Borrowings", "borrow", "1"]
            },
            "description": "🔒 Requires: Member — Replace '1' with the bookId. Idempotency-Key prevents duplicate requests."
          }
        },
        {
          "name": "Return Book (Admin/Librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Unique key per request to prevent duplicate returns"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/Borrowings/return/1",
